# Frontend / public URLs
NEXT_PUBLIC_API_URL=http://YOUR_EC2_PUBLIC_IP:8080
BACKEND_INTERNAL_URL=http://backend:8080
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8080
SCRAPER_HOST_PORT=9432

# Postgres
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=invisionu
DB_USER=invisionu
DB_PASSWORD=change-me
DB_SSLMODE=disable

# Backend
# for it we use: /backend/config/config.prod.yaml

# LLM scoring
GROQ_TEMPERATURE=0.2
GROQ_API_KEY=change-me
GROQ_MODEL=llama-3.3-70b-versatile

# STT
GROQ_WHISPER_API_KEY=change-me

# AI Detector (NoGPT, Anticheat)
# there is no .env's

# RAG + Telegram bot
OPENAI_API_KEY=change-me
TELEGRAM_BOT_TOKEN=change-me
CHROMA_URL=http://chroma:8000
RAG_INVOKE_URL=http://rag-app:8000/rag/invoke
RAG_TIMEOUT_SECONDS=60
