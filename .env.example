# Dev Secrets

# Frontend
NEXT_PUBLIC_API_URL=http://golang:8080

# Postgres
# Generates a high-entropy, base64-encoded string command:
# openssl rand -base64 16
DB_CLIENT=pg
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mydb
DB_USER=myuser
DB_PASSWORD=qwerty1234

# Backend
# for it we use: /backend/config/config.prod.yaml

# LLM Scoring
GROQ_TEMPERATURE=0.2
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"
# or GROQ_MODEL="openai/gpt-oss-120b"

# STT Whisper
GROQ_WHISPER_API_KEY=your_groq_whisper_api_key_here

# AI Detector (NoGPT, Anticheat)
# there is no .env's

# Parser API
# there is no .env's

# RAG + Telegram bot
OPENAI_API_KEY=change-me
TELEGRAM_BOT_TOKEN=change-me
CHROMA_URL=http://chroma:8000
RAG_INVOKE_URL=http://rag-app:8000/rag/invoke
RAG_TIMEOUT_SECONDS=60
